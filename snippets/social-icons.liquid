<ul class="social-icons__list {{ social_grid }}">
  {% if settings.etsy != blank %}
    <li>
      <a href="{{ settings.etsy }}" target="_blank" aria-label="Etsy">
        {% render 'snip-icons',
          wrapper: wrapper,
          type: 'social',
          icon: 'etsy',
          classes: 'share-icons--icon',
          size: '14px',
          fill: fill_color,
          hover: hover_color %}
      </a>
    </li>
  {% endif %}
  {% if settings.facebook_url != blank %}
    <li>
      <a href="{{ settings.facebook_url }}" target="_blank" aria-label="Facebook">
