{%- liquid
  if settings.cart_type == 'drawer'
    assign cart_type_class = 'ajax-cart__drawer-wrapper'
    assign cart_class = 'js-slideout-close'
    assign cart_data = 'data-slideout-direction="right" aria-controls="slideout-ajax-cart"'
  elsif settings.cart_type == 'modal_cart'
    assign cart_type_class = 'ajax-cart__modal-wrapper'
    assign cart_class = 'js-modal-close'
    assign cart_data = 'aria-controls="modal-ajax-cart"'
  endif
-%}

<section id="mini-cart" data-ajax-cart-mini class="mini-cart__container js-mini-cart-wrapper {{ cart_type_class }}">
  <div class="loading-wrapper js-mini-cart-loader">
    <div class="loading-ripple"><div></div><div></div></div>
  </div>
  <div class="ajax-cart__header-wrapper grid__wrapper edge">
    
    <div class="span-4 sm-span-4 auto a-left v-center">
      <div class="slideout__trigger--close">
        <button class="slideout__trigger-ajax-cart {{ cart_class }}" {{ cart_data }} aria-label="Close cart" tabindex="0" type="button" name="button">
          {% render 'snip-icons',
           wrapper: '.icn-close',
           type: 'apollo',
           icon: 'close',
           classes: '',
           size: '14px',
           fill: 'var(--text-color)',
           hover: 'var(--text-color)' %}
        </button>
      </div>
    </div>
    <div class="span-4 sm-span-4 auto v-center">
      <h2 class="h5 section-heading a-center mb0">{{ 'cart.general.title' | t }}</h2>
    </div>
    <div class="span-4 sm-span-4 auto a-right v-center">
      <p class="mb0"><span class="js-cart-count inline-block">{{ cart.item_count }}</span> {{ 'cart.general.items' | t }}</p>
    </div>
  </div>
      <a class="ajax-cart__header__continue-link mb0" href="{{ routes.all_products_collection_url }}" style="margin-left: 15px">
        {% render 'snip-icons',
             wrapper: '.ajax-cart__header__continue-link',
             type: 'apollo',
             icon: 'left-carrot',
             classes: 'ajax-cart__header__continue-link--icon vib-center',
             size: '12px',
             fill: 'var(--text-color)',
             hover: 'var(--text-color)' %}
        <span class="ajax-cart__header__continue-link-text sm-hide vib-center">{{ 'products.product.continue' | t }}</span>
      </a>
  <div class="ajax-cart__form-wrapper cart-wrapper js-ajax-cart-content">

  </div>
  {%- unless request.design_mode -%}
    {%- if additional_checkout_buttons -%}
      <div class="ajax-cart__footer-wrapper grid__wrapper edge">
        <div class="{{ footer_grid }} span-12 auto" id="dynamic">
          <p class="sm-caps or-divider mt2 mb2 a-center"><span>{{ 'cart.general.or' | t }}</span></p>
          <div class="ajax-cart__buttons-additional">
            {{ content_for_additional_checkout_buttons }}
          </div>
        </div>

      </div>
    {%- endif -%}
    {%- endunless -%}
          <div><img src="https://cdn.shopify.com/s/files/1/1421/6404/files/logos_d7bf2b1f-bc32-41e0-92bf-c5dc81d78a9b.png?v=1740872849">
</div>
</section>
