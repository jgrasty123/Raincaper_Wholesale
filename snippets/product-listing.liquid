{%- liquid

  case settings.product_image_size
    when 'natural'
      assign aspect_ratio = 'natural'
    when 'square'
      assign aspect_ratio = 'square'
    when 'landscape'
      assign aspect_ratio = 'landscape'
    when 'portrait'
      assign aspect_ratio = 'portrait'
  endcase

-%}

<div class="product-index-inner">
  {% if product.available %}
    {% for col in product.collections %}
      {% if col.handle == 'new' or  col.handle == 'whats-new' %}
        <div class="new icn {{ settings.icon_style }}">{{ 'products.general.new' | t }}</div>
      {% endif %}
    {% endfor %}
    {% if product.price < product.compare_at_price %}
      <div class="sale-item sale-item--{{ settings.sale_items }} icn {{ settings.icon_style }}">
        {% case settings.sale_items %}
          {% when 'percentage' %}
            {% if product.price_varies or product.compare_at_price_varies %}
              {{ 'products.general.sale' | t }}
            {% else %}
              {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price %}
              {% assign discount = discount | round | append: '%' %}
              {{ 'products.general.savings' | t: savings: discount }}
            {% endif %}
          {% when 'amount' %}
            {% if product.price_varies or product.compare_at_price_varies %}
              {{ 'products.general.sale' | t }}
            {% else %}
              {% assign discount = product.compare_at_price | minus: product.price | money %}
              {{ 'products.general.savings' | t: savings: discount }}
            {% endif %}
          {% when 'icon' %}
            {{ 'products.general.sale' | t }}
        {% endcase %}
      </div><!-- /.sale-item -->
    {% endif %}
    {% if product.template_suffix == 'pre-order' %}
      <div class="pre-order icn {{ settings.icon_style }}">{{ 'products.product.pre_order' | t }}</div>
    {% endif %}
  {% else %}
    <div class="so icn {{ settings.icon_style }}">{{ 'products.general.sold' | t }}</div>
  {% endif %}
</div>

<div class="js-product-image animated prod-image image_{{ aspect_ratio }}">
  <a href="{{ product.url | within: collection }}" title="{{ product.title | escape }}">
    <div class="reveal">

      {%- if product.media.size < 1 -%}

        <div class="box-ratio" style="padding-bottom: 100%;">
          {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
          {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
        </div>

      {% else %}

        {% if settings.product_grid_video %}

          {% if
            product.featured_media.media_type == 'video' or
            product.featured_media.media_type == 'external_video'
          %}

            {% render 'product-loop-video', product: product %}

          {% endif %}

          {%
            render "basic-responsive-image",
            type: product.featured_media.preview_image,
            width: 800,
            loading: loading,
            fetchpriority: fetchpriority
          %}

        {% else %}

        {%- assign second_image = product.media[1] -%}

          {%
            render 'basic-responsive-image',
            type: product.featured_media.preview_image,
            width: 1200,
            loading: loading,
            fetchpriority: fetchpriority
          %}

        {% endif %}

        {% if settings.switch_image and product.media.size > 1 and second_image.media_type == 'image' %}
          <div class="hidden">
            {% if settings.product_grid_video %}
              {% if
                product.featured_media.media_type == 'video' or
                product.featured_media.media_type == 'external_video'
              %}
              {% render 'product-loop-video', product: product %}
              {% endif %}
            {% endif %}
            {%
              render 'basic-responsive-image',
              type: product.media[1],
              width: 1200,
              loading: loading,
              fetchpriority: fetchpriority
            %}
          </div>
        {% elsif settings.switch_image and product.media.size > 1 and second_image.media_type != 'image' %}
          <div class="hidden">
            {% if settings.product_grid_video %}
              {% if
                product.featured_media.media_type == 'video' or
                product.featured_media.media_type == 'external_video'
              %}
              {% render 'product-loop-video', product: product %}
            {% endif %}
            {% endif %}
            {%
              render 'basic-responsive-image',
              type: product.media[1].preview_image,
              width: 1200,
              loading: 'lazy',
              fetchpriority: 'auto'
            %}
          </div>
        {% endif %}
      {%- endif -%}
    </div>
  </a>


  {% if settings.quickview_type != 'none' %}

    {%- liquid

      if settings.quickview_type == 'modal'
        assign quickview_classes = 'js-modal-open'
        assign quickview_settings = 'data-wau-modal-target="quickview"'
      else
        assign quickview_classes = 'js-slideout-open'
        assign quickview_settings = 'data-wau-slideout-target="quickview" data-slideout-direction="right"'
      endif

    -%}

    <button class="quick-view-{{ product.id }} product-listing__quickview-trigger {{ quickview_classes }} js-quickview-trigger"
    type="button" name="button"
    {{ quickview_settings }}
    data-product-url="{{ product.url }}?view=quick">{{ 'products.general.quick_view' | t }}</button>
  {% endif %}

  {% if settings.show_sizes != 'hidden' and product.variants.size >= 1 %}
    {% render 'product-listing-sizes' product: product %}
  {% endif %}

</div>

<div class="product-info">
  <div class="product-info-inner">
    <a href="{{ product.url | within: collection }}">
      {% if settings.vendor %}<span class="prod-vendor">{{ product.vendor }}</span>{% endif %}
      <span class="prod-title">{{ product.title }}</span>
    </a>

    {%- liquid
      assign card_sku = product.first_available_variant.sku
      if card_sku == blank
        assign card_sku = product.variants.first.sku
      endif
    -%}
    {%- if card_sku != blank -%}
      <span class="prod-sku" style="display:block; font-size:0.8em; opacity:0.7; margin:2px 0;">SKU: {{ card_sku }}</span>
    {%- endif -%}

<!-- Start of Judge.me code -->
  <div class='jdgm-widget jdgm-preview-badge'>
    {{ product.metafields.judgeme.badge }}
  </div>
<!-- End of Judge.me code -->
    {% render 'product-price-listing', product: product %}

    {% form 'product', product, data-product-form: product_form_config %}
  <!-- Hidden input for variant ID -->
  <input type="hidden" id="{{ product.first_available_variant.id }}" name="id" value="{{ product.first_available_variant.id }}" />

  {%- liquid
    assign card_rule = product.first_available_variant.quantity_rule
    assign card_min = settings.wholesale_qty_min | default: 1
    assign card_step = settings.wholesale_qty_step | default: 1
    if product.metafields.custom.moq_min.value != blank
      assign card_min = product.metafields.custom.moq_min.value
    endif
    if product.metafields.custom.moq_increment.value != blank
      assign card_step = product.metafields.custom.moq_increment.value
    endif
    if card_rule.min > 1
      assign card_min = card_rule.min
    endif
    if card_rule.increment > 1
      assign card_step = card_rule.increment
    endif
  -%}
  <!-- Quantity honors B2B catalog minimums; defaults to 1 outside a B2B catalog -->
  <input type="hidden" name="quantity" value="{{ card_min }}" />
  {%- if card_min > 1 or card_step > 1 -%}
    <p class="quantity-rule-note" style="font-size: 0.85em; margin: 4px 0 0; opacity: 0.75;">
      {%- if card_min > 1 -%}Min {{ card_min }}{%- endif -%}
      {%- if card_step > 1 %}{% if card_min > 1 %} &middot; {% endif %}units of {{ card_step }}{%- endif -%}
    </p>
  {%- endif -%}

  <!-- Success/Error messages (already present) -->
  <div class="note note-success mt3 js-added-msg" style="display: none">
    <b>{{ 'products.product.added' | t }}</b>&nbsp;&nbsp;&nbsp;
    <a class="underline" href="{{ routes.cart_url }}">
      {{ 'products.product.view_cart' | t }}
    </a> 
    {{ 'products.product.or' | t }}
    <a class="underline" href="{{ routes.all_products_collection_url }}">
      {{ 'products.product.continue' | t }}
    </a>.
  </div>
  <div class="note note-error js-error-msg" style="display: none">
    <b>{{ 'cart.general.cart_error' | t }}</b>&nbsp;&nbsp;&nbsp;
    {{ 'cart.general.update_qty_error' | t }}
  </div>

  <!-- Visible Add to Cart button -->
  {%- liquid
    if product.template_suffix == 'pre-order'
      assign call_to_action = 'products.product.pre_order' | t
      assign is_preorder = 'data-preorder'
    else
      assign call_to_action = 'products.product.add_to_cart' | t
      assign is_preorder = ''
    endif
    unless current_variant.available
      assign call_to_action = 'products.product.sold_out' | t
      assign is_preorder = ''
    endunless

    assign product_form_id = 'product-form-' | append: section.id

  -%}
 <button 
    type="submit"
    name="button"
    class="add AddtoCart js-ajax-submit {% if settings.show_payment_button and product.selling_plan_groups.size == 0 %} secondary-button{% endif %}" 
    {{ is_preorder }}
    {% unless current_variant.available %}disabled{% endunless %}
  >
    {{ call_to_action }}
  </button>
  {% comment %} {% if product.available %}
    <button
      type="submit"
      class="add js-ajax-submit add-to-cart-button"
      name="button"
      aria-label="{{ 'products.product.add_to_cart' | t }}"
    >
      {{ 'products.product.add_to_cart' | t }}
    </button>
  {% else %}
    <!-- If the product is sold out or unavailable -->
    <button
      type="submit"
      class="add js-ajax-submit add-to-cart-button"
      name="button"
      disabled
      aria-label="{{ 'products.product.sold_out' | t }}"
    >
      {{ 'products.product.sold_out' | t }}
    </button>
  {% endif %} {% endcomment %}
{% endform %}


    {% if settings.alternate_colors %}
      <div class="prod-colors">
        {% render 'product-listing-swatches', product: product %}
      </div>
    {% endif %}
  </div>
</div>