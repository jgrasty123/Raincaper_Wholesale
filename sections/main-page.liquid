<section class="page__section row grid__wrapper main__section" data-section-id="{{ section.id }}" data-section-type="page-section">
  <div class="span-12 auto">
    <div class="page__section-content">
      <h1 class="page-title page__section-title">{{ page.title }}</h1>
      {% if page.handle == 'wholesale' %}
        <div class="wholesale_login_buttons">
          <a href="{{ section.settings.login_link }}" class="w_login_btn">{{ section.settings.login_text }}</a>
          <a href="{{ section.settings.registration_link }}" class="w_registration_btn">{{ section.settings.registration_text }}</a>
        </div>
      {% endif %}
        <div class="rte">{{ page.content }}</div>
    </div>
    <style>
      @media screen and (min-width:741px) {
        .page__section-content {
          max-width: {{ section.settings.page_width }}%;
          margin: 0 auto;
        }
      }
      .wholesale_login_buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin: 0 0 40px;
      }
      .wholesale_login_buttons a {
        height: 46px;
        padding-inline: 30px;
        background: var(--button-color);
        color: var(--button-text);
        font-family: var(--main-family);
        font-weight: var(--main-weight);
        font-style: var(--main-style);
        font-size: var(--font-size);
        letter-spacing: var(--main-spacing);
        text-decoration: none;
        border: none;
        display: flex;
        align-items: center;
        border-radius: 3px;
      }
    </style>
  </div>
</section>

{% schema %}
  {
    "name": "Page options",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page content width",
        "unit":"%",
        "min":50,
        "max":100,
        "step":10,
        "default":100,
		    "info": "Set the content width for your pages, mobile will show at full page width"
      },
      {
        "type": "text",
        "id": "login_text",
        "label": "Wholesale Login Button Text",
        "default":"Wholesale Login",
        "info": "This button will show only on wholesale page"
      },
      {
        "type": "url",
        "id": "login_link",
        "label": "Wholesale Login Button Link",
      },
      {
        "type": "text",
        "id": "registration_text",
        "label": "Wholesale Registration Button Text",
        "default":"Wholesale Registration",
        "info": "This button will show only on wholesale page"
      },
      {
        "type": "url",
        "id": "registration_link",
        "label": "Wholesale Registration Button Link",
      },
    ]
  }
{% endschema %}
