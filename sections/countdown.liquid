{%- liquid

  assign section_space = section.settings.section_space
  assign section_space_class = ''

  if section_space == 'top'
    assign section_space_class = ' pb0'
  elsif section_space == 'bottom'
    assign section_space_class = ' mt0'
  elsif section_space == 'none'
    assign section_space_class = ' mt0 pb0'
  endif

  if section.settings.full_width
    assign full_width =  'edge'
  endif

  assign layout = 'center'
  if section.settings.layout == 'split'
    assign layout = 'space-between'
  elsif section.settings.layout == 'stack'
    assign layout = 'stack'
  endif

  if section.index == 1
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif

  assign has_image = false

  for block in section.blocks
    case block.type

      when 'countdown'

        assign year = block.settings.year
        assign month = block.settings.month
        assign day = block.settings.day
        assign hour = block.settings.hour
        assign minute = block.settings.minute

        assign date_now = "now" | date: "%s"
        assign countdown_date = month | append: ' ' | append: day | append: ',' | append: ' ' | append: year | append: ' ' | append: hour | append: ':' | append: minute | append: ':' | append: '00'
        assign countdown_end_date = countdown_date | date: "%s"

        assign timestamp = countdown_end_date

        assign countdown_exists = false
        if countdown_end_date > date_now
          assign countdown_exists = true
        endif

        assign button_text = block.settings.countdown_button | escape
        assign link = block.settings.countdown_link

        assign has_button = false
        if link != blank and button_text != blank
          assign has_button = true
        endif

      when 'text'

        assign heading = block.settings.heading | escape
        assign rich_text = block.settings.countdown_text

      when 'image'

        assign background_image = block.settings.background_image
        assign desktop_height = block.settings.desktop_height
        assign mobile_height = block.settings.mobile_height
        assign overlay = block.settings.overlay
        assign has_image = true

    endcase

  endfor

-%}

{% style %}
#shopify-section-{{ section.id }} {
  --background: {{ section.settings.background_color }};
  --text-color: {{ section.settings.text_color }};
  --button-text: {{ section.settings.button_color }};
  --button-color: {{ section.settings.button_background }};
  --h3-size: {{ section.settings.heading_font_size }}px;
  --font-size: {{ section.settings.font_size }}px;
}
{% for block in section.blocks %}
{% if block.type == 'image' %}
  #shopify-section-{{ section.id }} .countdown__grid.has--image {
    --section-desktop-height: {{ desktop_height }}px;
    --section-mobile-height: {{ mobile_height }}px;
  }
{% endif %}
{% endfor %}
{% endstyle %}


<div class="global__section section-countdown {{ section_space_class }}"
  data-section-id="{{ section.id }}"
  data-section-type="countdown"
  data-base-url="{{ shop.url}}{{ routes.root_url }}"
  data-launch-date="{{ timestamp }}"
  data-hide-after-countdown="{{ section.settings.hide_after_countdown }}"
  >

  <div class="row grid__wrapper rg0 {{ full_width }}">
    <div id="countdownWrapper" class="countdown__wrapper span-12 auto">

      <div class="countdown__grid l-{{ layout }}{% if has_image %} has--image{% endif %}">
        {% for block in section.blocks %}

          {% if block.type == 'image' %}

            <div class="countdown__image-container" {{ block.shopify_attributes }}>
              {% if background_image %}
                {%
                  render 'basic-responsive-image',
                  type: block.settings.background_image,
                  width: 2400,
                  loading: loading,
                  fetchpriority: fetch_priority
                %}
              {% else %}
                <div class="onboard placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
              {% if overlay %}
                <div class="overlay"></div>
              {% endif %}
            </div>

        {% endif %}

          {% if block.type == 'countdown' %}
            <div class="countdown__time-container" {{ block.shopify_attributes }}>
              {% if countdown_exists %}
                <div class="countdown__time--wrapper a-center">
                  <p class="countdown__time mb0" data-launch-days>00</p>
                  <p class="countdown__time-label mb0">{{ 'sections.countdown.days' | t }}</p>
                  <span class="countdown__colon-divider">:</span>
                </div>
                <div class="countdown__time--wrapper a-center">
                  <p class="countdown__time mb0" data-launch-hours>00</p>
                  <p class="countdown__time-label mb0">{{ 'sections.countdown.hours' | t }}</p>
                  <span class="countdown__colon-divider">:</span>
                </div>
                <div class="countdown__time--wrapper a-center">
                  <p class="countdown__time mb0" data-launch-mins>00</p>
                  <p class="countdown__time-label mb0">{{ 'sections.countdown.mins' | t }}</p>
                  <span class="countdown__colon-divider">:</span>
                </div>
                <div class="countdown__time--wrapper a-center">
                  <p class="countdown__time mb0" data-launch-secs>00</p>
                  <p class="countdown__time-label mb0">{{ 'sections.countdown.secs' | t }}</p>
                </div>

                {% if has_button %}
                  <div class="countdown__button-wrapper">
                    <a class="btn" href="{{ link }}">{{ button_text }}</a>
                  </div>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}

          {% if block.type == 'text' %}
            <div class="countdown__heading countdown__time--content block-{{ block.id }}" {{ block.shopify_attributes }}>
              {% if heading != blank %}
                <h3 class="mb0">{{ heading }}</h3>
              {% endif %}
              {% if rich_text != blank %}
                {{ rich_text }}
              {% endif %}
            </div>

            <div class="countdown__ended--content" style="display:none;">
              {{ block.settings.countdown_complete_text }}
            </div>

          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% if section.settings.hide_after_countdown and countdown_exists == false %}
      {% style %}
        #shopify-section-{{ section.id }} {
          display: none;
        }
      {% endstyle %}
  {% endif %}

</div>

